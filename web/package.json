    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@near-js/crypto": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
